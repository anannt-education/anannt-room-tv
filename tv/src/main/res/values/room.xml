<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Compose screens of Room TV: a plain full-screen dark theme, nothing from the launcher's drawing code. -->
    <style name="RoomTv" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#070B1E</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- Shown by Android where accessibility services are listed (Settings > Accessibility). -->
    <string name="room_control_service">Lets the Anannt Room TV phone app press Back, Home and the arrow keys while another app is open. It does not read the screen.</string>
</resources>
