<?xml version="1.0" encoding="utf-8"?>
<!-- Optional, off by default. No window content (canRetrieveWindowContent is off), no key filter, no gestures: it only
     learns which app's window came to the front, and can press Back, Home and the D-pad for the phone. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/room_control_service" />
